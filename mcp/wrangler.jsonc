{
  "name": "loom-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.{html,css,txt,mjs}"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // LOOM-509: upload maps to Cloudflare observability (never into the Worker bundle's public surface).
  "upload_source_maps": true
}
