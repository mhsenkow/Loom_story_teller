{
  "name": "loom-storyteller",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 1337 -H 0.0.0.0",
    "build": "next build && node scripts/write-build-id.mjs",
    "start": "npm run preview",
    "preview": "npx serve out -s -l 3000",
    "lint": "eslint src e2e --max-warnings=850",
    "tauri": "tauri",
    "spin": "npm run tauri dev",
    "weave": "npm run tauri build",
    "tablet": "npm run tauri ios dev",
    "tablet:build": "npm run tauri ios build -- --export-method app-store-connect",
    "tablet:xcode": "npm run tauri ios build -- --open",
    "thread": "npm run dev",
    "spool": "python3 scripts/generate_data.py",
    "spool:small": "python3 scripts/generate_data.py --size small",
    "spool:mega": "python3 scripts/generate_data.py --size mega",
    "check": "tsc --noEmit",
    "check:worker": "tsc --noEmit -p workers/tsconfig.json",
    "check:mcp": "cd mcp && npm ci && npx tsc --noEmit -p tsconfig.json",
    "test:node": "vitest run 'src/**/*.test.ts' 'workers/**/*.test.ts'",
    "test:dom": "vitest run -c vitest.dom.config.ts",
    "preflight": "scripts/preflight-runtimes.sh",
    "fmt": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run && vitest run -c vitest.dom.config.ts --passWithNoTests",
    "test:e2e": "LOOM_E2E=1 playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "check:rust-full": "cd src-tauri && cargo fmt --check && cargo clippy -- -D warnings && cargo test"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tanstack/react-virtual": "^3.13.21",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "d3-geo": "^3.1.1",
    "hyparquet": "^1.31.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vega": "^6.2.0",
    "vega-lite": "^5.21.0",
    "world-atlas": "^2.0.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitest/coverage-v8": "^3.2.4",
    "@webgpu/types": "^0.1.69",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.6.2",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.140.0"
  },
  "overrides": {
    "vega-lite": {
      "vega": "$vega"
    }
  }
}
