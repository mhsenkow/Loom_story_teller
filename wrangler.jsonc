{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Loom web UI — static Next.js export + open-data catalog proxy.
  // Deploy: make loft  →  loom.ibm.io (+ workers.dev)
  "name": "loom-storyteller",
  "main": "workers/catalog-proxy.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/p/*", "/plot/*", "/oembed"]
  },
  "kv_namespaces": [
    {
      "binding": "LOOM_STORIES",
      "id": "39d5f9a582684aeea970bb92a3e7b1df",
      "preview_id": "cd3cf9384ec54444ace1549f2b9dd399"
    }
  ],
  // Always-on monitors (workers/monitorCron.ts): evaluate due cloud monitors every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "loom.ibm.io", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // LOOM-509: upload maps to Cloudflare observability (not into public ASSETS/`out`).
  "upload_source_maps": true,
  // LOOM-654: browser-origin allowlist is defined once in workers/allowedOrigins.ts
  // (DEFAULT_ALLOWED_ORIGIN_HOSTS). Set `vars.ALLOWED_ORIGIN_HOSTS` here ONLY to override it
  // for a staging deploy — do not paste a second copy of the default list.
  // Story/feedback rate limits use LOOM_STORIES KV keys `rl:*` (LOOM-102) for cross-colo caps.
}
