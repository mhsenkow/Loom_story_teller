{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Loom web UI — static Next.js export + open-data catalog proxy.
  // Deploy: make loft  →  loom.ibm.io (+ workers.dev)
  "name": "loom-storyteller",
  "main": "workers/catalog-proxy.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "routes": [
    { "pattern": "loom.ibm.io", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
